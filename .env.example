HF_API_TOKEN=replace-with-your-hugging-face-token
HF_MODEL=
# sql-service generation model only (blank = defog/sqlcoder-7b-2)
SQL_HF_MODEL=
# Story 8.2 (docs/sql-service-demo-runbook.md): Plan B model (blank = SQL_HF_MODEL), sql-service profiles, LLM-down demo
SQL_HF_MODEL_PLANB=
SQL_SPRING_PROFILES=demo
SQL_DEMO_LLM_DEAD_HOST=false
HF_EMBEDDING_MODEL=
# bug-service triage LLM (OpenAI-compatible chat endpoint). Blank = HF_API_TOKEN on the Hugging Face router with
# meta-llama/Llama-3.1-8B-Instruct. Free alternative: a Groq key with BUG_LLM_BASE_URL=https://api.groq.com/openai/v1
# and BUG_LLM_MODEL=llama-3.1-8b-instant
BUG_LLM_API_KEY=
BUG_LLM_BASE_URL=
BUG_LLM_MODEL=
POSTGRES_USER=devassist
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
COMMIT_DB=commit_db
SNIPPET_DB=snippet_db
BUG_DB=bug_db
SQL_DB=sql_db
REVIEW_DB=review_db
COMMIT_DB_USER=commit_user
COMMIT_DB_PASSWORD=change-me-commit
SNIPPET_DB_USER=snippet_user
SNIPPET_DB_PASSWORD=change-me-snippet
BUG_DB_USER=bug_user
BUG_DB_PASSWORD=change-me-bug
SQL_DB_USER=sql_user
SQL_DB_PASSWORD=change-me-sql
REVIEW_DB_USER=review_user
REVIEW_DB_PASSWORD=change-me-review
FRONTEND_ORIGIN=http://localhost:4200
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka
QDRANT_HOST=qdrant
QDRANT_PORT=6334
